<form asp-controller="Appointment" asp-action="DeleteSelectedAppointments" method="post" id="delete-form">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="my-4 text-primary fw-bold">🗓️ Appointment List</h2>
        <div class="m-3 d-flex gap-2">
            <a asp-controller="Appointment" asp-action="AppointmentAddEdit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add
            </a>

            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete selected appointments?');">
                <i class="bi bi-trash3-fill"></i> Delete Selected
            </button>

            
           

            <a class="btn btn-success ms-2"
               asp-controller="Appointment"
               asp-action="ExportToExcel">
                Export To Excel
            </a>

        </div>
    </div>

    <div class="row m-3">
        <div class="col-md-3">
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Search Status,des,remark" value="@ViewBag.SearchData" />
        </div>
        <div class="col-md-3">
            <input type="text" id="searchDoctor" class="form-control"
                   placeholder="Search Doctor" value="@ViewBag.SearchDoctor" />
        </div>
        <div class="col-md-3">
            <input type="text" id="searchDate" class="form-control"
                   placeholder="Search AppointmentDate" value="@ViewBag.SearchDate" />
        </div>
        <div class="col-md-3 d-flex gap-2 align-items-start">
                <button type="button" class="btn btn-primary" onclick="doSearch()">Search</button>    
                <a href="@Url.Action("Index", "Appointment")" class="btn btn-secondary">Clear</a>
        </div>
        
    </div>

   

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center fw-semibold">@TempData["Message"]</div>
    }
    @if (ViewBag.InsertMessage!=null)
    {
        <div class="alert alert-success text-center fw-semibold">@ViewBag.InsertMessage </div>
    }
    

    <div class="table-responsive rounded-4 shadow-sm border">
        <table class="table table-bordered table-hover align-middle text-center mb-0">
            <thead class="table-primary text-white align-middle text-center">
                <tr>
                    <th>
                        <input type="checkbox" id="select-all" class="form-check-input" /> <br />
                        Select All <br />
                        <i class="bi bi-hash fs-5 text-warning"></i>
                    </th>
                    <th>Appointment ID<br><i class="bi bi-hash fs-5 text-warning"></i></th>
                    <th>DoctorName<br><i class="bi bi-person-badge fs-5 text-primary"></i></th>
                    <th>PatientName<br><i class="bi bi-person-lines-fill fs-5 text-danger"></i></th>
                    <th>Appointment Date<br><i class="bi bi-calendar-event fs-5 text-info"></i></th>
                    <th>Status<br><i class="bi bi-check-circle fs-5 text-success"></i></th>
                    <th>Description<br><i class="bi bi-card-text fs-5 text-secondary"></i></th>
                    <th>Remarks<br><i class="bi bi-chat-text fs-5 text-muted"></i></th>
                    <th>Created<br><i class="bi bi-clock-history fs-5 text-success"></i></th>
                    <th>Modified<br><i class="bi bi-pencil-square fs-5 text-warning"></i></th>
                    <th>User ID<br><i class="bi bi-person-circle fs-5 text-info"></i></th>
                    <th>Total Amount<br><i class="bi bi-currency-rupee fs-5 text-success"></i></th>
                    <th class="col-2">Action<br><i class="bi bi-tools fs-5 text-danger"></i></th>
                </tr>
            </thead>

            <tbody class="table-group-divider">
                @foreach (DataRow dr in Model.Rows)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input appointment-checkbox" name="selectedAppointments" value="@dr["AppointmentID"]" />
                        </td>
                        <td><span class="text-dark badge bg-primary-light rounded-circle p-2 px-3">@dr["AppointmentID"]</span></td>
                        <td>@dr["DoctorName"]</td>
                        <td>@dr["PatientName"]</td>
                        <td>@Convert.ToDateTime(dr["AppointmentDate"]).ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-@((dr["AppointmentStatus"].ToString() == "Confirmed") ? "primary" : (dr["AppointmentStatus"].ToString() == "Pending") ? "warning text-dark" : (dr["AppointmentStatus"].ToString() == "Completed") ? "success" : "danger")">
                                @dr["AppointmentStatus"]
                            </span>
                        </td>
                        <td>@dr["Description"]</td>
                        <td>@dr["SpecialRemarks"]</td>
                        <td>@Convert.ToDateTime(dr["Created"]).ToString("dd MMM yyyy")</td>
                        <td>@Convert.ToDateTime(dr["Modified"]).ToString("dd MMM yyyy")</td>
                        <td>@dr["UserID"]</td>
                        <td>₹ @dr["TotalConsultedAmount"]</td>
                        <td>
                            <div class="d-flex justify-content-center gap-2">
                                <a class="btn btn-sm btn-outline-success"
                                   asp-controller="Appointment"
                                   asp-action="AppointmentEdit"
                                   asp-route-DecAppointmentID="@UrlEncryptor.Encrypt(dr["AppointmentID"].ToString())"
                                   title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a class="btn btn-sm btn-outline-danger"
                                   asp-controller="Appointment"
                                   asp-action="AppointmentDelete"
                                   asp-route-AppointmentID="@UrlEncryptor.Encrypt(dr["AppointmentID"].ToString())"
                                   onclick="return confirm('Are you sure you want to delete this appointment?');"
                                   title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </a>

                                @* <a asp-controller="Appointment"
                                   asp-action="AppointmentDelete"
                                   asp-route-AppointmentID="@UrlEncryptor.Encrypt(dr["AppointmentID"].ToString())">Delete</a> *@

                               

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

<script>
    document.getElementById("select-all").addEventListener("change", function () {
        const checkboxes = document.querySelectorAll(".appointment-checkbox");
        checkboxes.forEach(chk => chk.checked = this.checked);
    });

   
    function doSearch() {
        var search = document.getElementById("searchInput").value;
        var search2 = document.getElementById("searchDoctor").value;
        var search3 = document.getElementById("searchDate").value;
        // Redirect using GET request
        window.location.href = '@Url.Action("Search", "Appointment")' + '?SearchData=' + encodeURIComponent(search) + '&SearchDoctor='+encodeURIComponent(search2)+'&SearchDate='+encodeURIComponent(search3);
    }

</script>


